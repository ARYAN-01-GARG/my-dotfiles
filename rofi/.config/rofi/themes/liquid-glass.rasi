/* ──────────────────────────────────────────────────────────────
   Liquid Glass — Aryan's rofi launcher (Super+D)
   Pairs with Hyprland `layerrule = blur, rofi` (already on).
   ────────────────────────────────────────────────────────────── */

configuration {
    modi:                       "drun,run,filebrowser,window";
    show-icons:                 true;
    display-drun:               "  apps";
    display-run:                "  term";
    display-filebrowser:        "  files";
    display-window:             "  window";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
    hover-select:               true;
    me-select-entry:            "MouseSecondary";
    me-accept-entry:            "MousePrimary";
}

/* Load wallust palette for color0…color15 */
@theme "~/.config/rofi/wallust/colors-rofi.rasi"

* {
    /* Liquid-glass accent palette (Catppuccin Mocha aligned) */
    lg-accent:        #cba6f7;
    lg-accent-2:      #89b4fa;
    lg-accent-3:      #94e2d5;
    lg-critical:      #f38ba8;
    lg-warning:       #f9e2af;
    lg-text:          #e8e8f0;
    lg-text-dim:      #b4b4c8;
    lg-text-faint:    #8a8a9d;

    /* Frosted glass surfaces (Hyprland blurs what's behind) */
    lg-surface:       rgba(15, 15, 23, 0.55);
    lg-surface-2:     rgba(25, 25, 38, 0.72);
    lg-surface-3:     rgba(0,  0,  0,  0.30);
    lg-border:        rgba(255, 255, 255, 0.18);
    lg-border-strong: rgba(255, 255, 255, 0.32);

    background-color: transparent;
    text-color:       @lg-text;
}

/*****----- Main window -----*****/
window {
    transparency:        "real";
    location:            center;
    anchor:              center;
    fullscreen:          false;
    width:               560px;
    x-offset:            0px;
    y-offset:            0px;

    enabled:             true;
    margin:              0px;
    padding:             0px;
    border:              1px solid;
    border-radius:       20px;
    border-color:        @lg-border;
    background-color:    @lg-surface;
    cursor:              "default";
}

/*****----- Main box -----*****/
mainbox {
    enabled:             true;
    spacing:             12px;
    margin:              0px;
    padding:             18px;
    border:              0px solid;
    background-color:    transparent;
    children:            [ "inputbar", "message", "listview" ];
}

/*****----- Input bar -----*****/
inputbar {
    enabled:             true;
    spacing:             10px;
    margin:              0px;
    padding:             12px 16px;
    border:              1px solid;
    border-radius:       14px;
    border-color:        @lg-border;
    background-color:    @lg-surface-3;
    text-color:          @lg-text;
    children:            [ "textbox-prompt-colon", "entry", "num-filtered-rows", "textbox-num-sep", "num-rows" ];
}

textbox-prompt-colon {
    enabled:             true;
    padding:             4px 4px 4px 0px;
    expand:              false;
    str:                 "";
    background-color:    inherit;
    text-color:          @lg-accent;
    font:                "JetBrainsMono Nerd Font 14";
}

entry {
    enabled:             true;
    padding:             4px 0px;
    background-color:    transparent;
    text-color:          @lg-text;
    cursor:              text;
    placeholder:         "Search apps, run, files…";
    placeholder-color:   @lg-text-faint;
}

num-filtered-rows {
    enabled:             true;
    expand:              false;
    background-color:    transparent;
    text-color:          @lg-text-faint;
}
textbox-num-sep {
    enabled:             true;
    expand:              false;
    str:                 "/";
    background-color:    transparent;
    text-color:          @lg-text-faint;
}
num-rows {
    enabled:             true;
    expand:              false;
    background-color:    transparent;
    text-color:          @lg-text-faint;
}
case-indicator {
    enabled:             true;
    background-color:    transparent;
    text-color:          @lg-text-faint;
}

/*****----- Listview -----*****/
listview {
    enabled:             true;
    columns:             1;
    lines:               8;
    cycle:               true;
    dynamic:             true;
    scrollbar:           true;
    layout:              vertical;
    reverse:             false;
    fixed-height:        true;
    fixed-columns:       true;

    spacing:             4px;
    margin:              0px;
    padding:             4px;
    border:              0px solid;
    border-radius:       12px;
    background-color:    transparent;
    text-color:          @lg-text;
    cursor:              "default";
}

scrollbar {
    handle-width:        4px;
    handle-color:        @lg-accent;
    border-radius:       999px;
    background-color:    transparent;
}

/*****----- Elements -----*****/
element {
    enabled:             true;
    spacing:             12px;
    margin:              0px;
    padding:             10px 12px;
    border:              1px solid;
    border-radius:       12px;
    border-color:        transparent;
    background-color:    transparent;
    text-color:          @lg-text;
    cursor:              pointer;
}

element normal.normal {
    background-color:    transparent;
    text-color:          @lg-text-dim;
}
element normal.urgent {
    background-color:    rgba(243, 139, 168, 0.18);
    text-color:          @lg-critical;
}
element normal.active {
    background-color:    rgba(148, 226, 213, 0.14);
    text-color:          @lg-accent-3;
}

element selected.normal,
element selected.urgent,
element selected.active {
    background-color:    @lg-surface-2;
    border-color:        @lg-accent;
    text-color:          @lg-text;
}

element alternate.normal {
    background-color:    transparent;
    text-color:          @lg-text-dim;
}
element alternate.urgent {
    background-color:    transparent;
    text-color:          @lg-critical;
}
element alternate.active {
    background-color:    transparent;
    text-color:          @lg-accent-3;
}

element-icon {
    size:                26px;
    background-color:    transparent;
    text-color:          inherit;
    cursor:              inherit;
    vertical-align:      0.5;
}
element-text {
    background-color:    transparent;
    text-color:          inherit;
    highlight:           bold #cba6f7;
    cursor:              inherit;
    vertical-align:      0.5;
    horizontal-align:    0.0;
}

/*****----- Mode switcher -----*****/
mode-switcher {
    enabled:             true;
    expand:              false;
    orientation:         horizontal;
    spacing:             6px;
    margin:              0px;
    padding:             0px;
    border:              0px solid;
    background-color:    transparent;
    text-color:          @lg-text;
}

button {
    padding:             6px 14px;
    border:              1px solid;
    border-radius:       10px;
    border-color:        @lg-border;
    background-color:    @lg-surface-3;
    text-color:          @lg-text-dim;
    vertical-align:      0.5;
    horizontal-align:    0.5;
    cursor:              pointer;
}
button selected {
    border-color:        @lg-accent;
    background-color:    @lg-surface-2;
    text-color:          @lg-text;
}

/*****----- Message bubble -----*****/
message {
    enabled:             true;
    margin:              0px;
    padding:             0px;
    border:              0px solid;
    background-color:    transparent;
    text-color:          @lg-text;
}
textbox {
    padding:             10px 14px;
    border:              1px solid;
    border-radius:       12px;
    border-color:        @lg-border;
    background-color:    @lg-surface-3;
    text-color:          @lg-text;
    vertical-align:      0.5;
    horizontal-align:    0.0;
    highlight:           none;
    placeholder-color:   @lg-text-faint;
    blink:               true;
    markup:              true;
}
error-message {
    padding:             10px 14px;
    border:              1px solid;
    border-radius:       12px;
    border-color:        @lg-critical;
    background-color:    rgba(243, 139, 168, 0.18);
    text-color:          @lg-text;
}
