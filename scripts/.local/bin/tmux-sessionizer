#!/usr/bin/env bash

# Centralized tmux-sessionizer stowed script
# Autogenerated for ARYAN'S ARCH-HYPRLAND setup

switch_to() {
  if [[ -z $TMUX ]]; then
    tmux attach-session -t "$1"
  else
    tmux switch-client -t "$1"
  fi
}

has_session() {
  tmux list-sessions | grep -q "^$1:"
}

hydrate() {
  if [ -f "$2/.tmux-sessionizer" ]; then
    tmux send-keys -t "$1" "source \"$2/.tmux-sessionizer\"" C-m
  elif [ -f "$HOME/.tmux-sessionizer" ]; then
    tmux send-keys -t "$1" "source \"$HOME/.tmux-sessionizer\"" C-m
  fi
}

# Verify dependencies
if ! command -v fzf >/dev/null 2>&1; then
  echo "❌ Error: fzf is not installed. Please install it to use tmux-sessionizer." >&2
  exit 1
fi

FD_CMD="fd"
if ! command -v fd >/dev/null 2>&1; then
  if command -v fdfind >/dev/null 2>&1; then
    FD_CMD="fdfind"
  else
    echo "❌ Error: fd is not installed. Please install it (fd-find) to use tmux-sessionizer." >&2
    exit 1
  fi
fi

# Use CLI arg if provided, otherwise fzf from custom search paths
if [[ $# -eq 1 ]]; then
  selected=$1
else
  # Curated list of search directories that exist
  SEARCH_DIRS=()
  for dir in "$HOME/my-dotfiles" "$HOME/Desktop" "$HOME/Projects" "$HOME/Code" "$HOME/src" "$HOME"; do
    if [[ -d "$dir" ]]; then
      SEARCH_DIRS+=("$dir")
    fi
  done

  # Search with high-speed exclusions to prevent scanning millions of system/cache files
  selected=$($FD_CMD . "${SEARCH_DIRS[@]}" -t d -d 3 \
    --exclude .git \
    --exclude node_modules \
    --exclude .cache \
    --exclude .local \
    --exclude .cargo \
    --exclude .rustup \
    --exclude .npm \
    --exclude .mozilla \
    --exclude .var \
    2>/dev/null | fzf --height=75% --prompt="🛸 Go to project > " --border=rounded --margin=1 --padding=1)
fi

# Abort if nothing selected
if [[ -z $selected ]]; then
  exit 0
fi

# Normalize session name (basename with dots replaced by underscores)
selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# Create session if tmux not running
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
  tmux new-session -ds "$selected_name" -c "$selected"
  hydrate "$selected_name" "$selected"
fi

# Create session if it doesn't exist
if ! has_session "$selected_name"; then
  tmux new-session -ds "$selected_name" -c "$selected"
  hydrate "$selected_name" "$selected"
fi

# Switch or attach
switch_to "$selected_name"
